{
  "expo": {
    "name": "WayMate",
    "slug": "waymate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "waymate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waymate.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WayMate needs your location to show nearby rides and track trip telemetry."
      }
    },
    "android": {
      "package": "com.waymate.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://192.168.2.7:8781",
      "eas": {
        "projectId": "4dee0161-7ed4-499f-b676-c43264c941a8"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WayMate uses your location to show nearby rides, routes, and biker community events."
        }
      ],
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0052FF"
        }
      ]
    ]
  }
}
